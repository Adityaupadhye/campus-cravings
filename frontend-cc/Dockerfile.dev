# Use slim node image
FROM node:22-slim

# Set working directory
WORKDIR /app

# Install dependencies
COPY package.json ./
RUN npm install

# Copy the rest of the app
COPY . .

# Expose default Angular dev port
EXPOSE 4200

# Run Angular dev server with polling for file changes (good for Docker/macOS)
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--poll", "1000"]
